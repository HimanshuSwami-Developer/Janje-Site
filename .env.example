# Copy to .env; Django loads it on startup. Real environment variables (e.g. from your hosting
# dashboard) take priority. All values are optional for local development.

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins, e.g. https://janje.co,https://www.janje.co
DJANGO_CSRF_TRUSTED_ORIGINS=

# Postgres connection string, e.g. from Neon. Leave empty to use the local db.sqlite3 file.
DATABASE_URL=

# Cloudinary for uploaded images (Cloudinary dashboard → API Keys). Fill in all three, or set
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name> instead. Leave empty to save
# uploads in the local media/ folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=janje

# --- Email -------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Janjé <hello@janje.co>

# --- Boutique ----------------------------------------------------------------
JANJE_INSTAGRAM_HANDLE=janje.co
JANJE_WHATSAPP_NUMBER=9718751020
# Merchant UPI ID for the scan-to-pay QR / UPI link, e.g. janje@okaxis
JANJE_UPI_ID=9718751020@ptyes
JANJE_UPI_PAYEE_NAME=Janje Blush and Bow

# --- Admin account -----------------------------------------------------------
# Read by `python manage.py createsuperuser --noinput`. Use a strong password.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
